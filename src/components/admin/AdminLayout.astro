---
/** 后台统一布局：复用主站主题初始化，但使用专属工作台导航与层级。 */
import Layout from "@/layouts/Layout.astro";
import "@/styles/admin.css";
import { siteConfig } from "@/config/siteConfig";
import { url } from "@/utils/url-utils";

interface Props {
	title?: string;
	active?: "posts" | "new";
	authed?: boolean;
	username?: string;
}

const { title = "后台管理", active, authed = true, username = "" } = Astro.props;
const navItems = [
	{ key: "posts", label: "文章", href: url("/admin/") },
	{ key: "new", label: "写文章", href: url("/admin/posts/new/") },
] as const;
---

<Layout title={`${title} · ${siteConfig.title}`} description={title}>
	<div class="admin-shell">
		{authed && (
			<header class="admin-topbar">
				<div class="admin-topbar-inner">
					<a href={url("/admin/")} class="admin-brand" aria-label="Firefly 后台首页">
						<span class="admin-brand-mark" aria-hidden="true">F</span>
						<span>Firefly 后台</span>
					</a>
					<nav class="admin-nav" aria-label="后台主导航">
						{navItems.map((item) => (
							<a href={item.href} class="admin-nav-link" data-active={active === item.key} aria-current={active === item.key ? "page" : undefined}>
								{item.label}
							</a>
						))}
					</nav>
					<div class="admin-top-actions">
						<a href={url("/")} class="admin-top-action" data-secondary="true" target="_blank" rel="noopener">查看站点</a>
						{username && <span class="admin-user" title={username}>{username}</span>}
						<button type="button" class="admin-btn" id="admin-logout">退出</button>
					</div>
				</div>
			</header>
		)}
		<main class="admin-main"><slot /></main>
	</div>
</Layout>

<script>
	const btn = document.getElementById("admin-logout");
	btn?.addEventListener("click", async () => {
		btn.setAttribute("disabled", "true");
		try {
			await fetch(`${import.meta.env.BASE_URL}api/admin/logout`, { method: "POST" });
		} finally {
			location.href = `${import.meta.env.BASE_URL}admin/login/`;
		}
	});
</script>
