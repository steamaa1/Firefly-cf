---
/**
 * 文章编辑器（新建与编辑共用）。
 *
 * 表单右栏的字段顺序对齐 src/content.config.ts 的 posts schema，
 * 便于对照；正文用纯 textarea + 实时预览，不引入第三方编辑器依赖，
 * 保持「零新增依赖、可控」的原则。预览样式复用 Markdown.astro。
 */
import type { AdminPost } from "@/lib/admin/posts";

interface Props {
	/** 已有文章；新建时为 null */
	post?: AdminPost | null;
}

const { post = null } = Astro.props;
const isEdit = Boolean(post);

const v = {
	slug: post?.slug ?? "",
	title: post?.title ?? "",
	description: post?.description ?? "",
	body_md: post?.body_md ?? "",
	image: post?.image ?? "",
	category: post?.category ?? "",
	lang: post?.lang ?? "",
	pinned: post?.pinned === 1,
	draft: post ? post.draft === 1 : true,
	comment: post ? post.comment === 1 : true,
	author: post?.author ?? "",
	source_link: post?.source_link ?? "",
	license_name: post?.license_name ?? "",
	license_url: post?.license_url ?? "",
	password: post?.password ?? "",
	password_hint: post?.password_hint ?? "",
	series: post?.series ?? "",
	series_order: post?.series_order ?? "",
	tags: post?.tags ?? "",
	published_at: post?.published_at ? post.published_at.slice(0, 10) : new Date().toISOString().slice(0, 10),
};
---

<div id="editor-alert" class="admin-alert admin-alert-error mb-4 hidden" role="alert"></div>
<div id="editor-ok" class="admin-alert admin-alert-ok mb-4 hidden" role="status" aria-live="polite"></div>

<form id="post-form" data-edit={isEdit ? "1" : "0"} data-slug={v.slug}>
	<div class="admin-editor-grid">
		<!-- 左栏：标题 + 正文 -->
		<div class="admin-editor-main">
			<section class="admin-section-card">
				<div class="admin-section-card-header">
					<h2 class="admin-section-card-title">基本信息</h2>
				</div>
				<div class="admin-section-card-body">
					<label class="admin-field mb-4">
						<span class="admin-label">标题</span>
						<input
							class="admin-input admin-editor-title-input"
							name="title"
							value={v.title}
							required
						/>
					</label>

					<label class="admin-field">
						<span class="admin-label">描述（摘要，用于列表与 SEO）</span>
						<textarea
							class="admin-textarea"
							name="description"
							rows="2"
							style="min-height: 4rem; font-family: inherit;">{v.description}</textarea>
					</label>
				</div>
			</section>

			<section class="admin-section-card">
				<div class="admin-section-card-header">
					<label class="admin-section-card-title" for="body-input">正文（Markdown）</label>
				</div>
				<div class="admin-section-card-body">
					<div class="admin-editor-toolbar">
						<span class="admin-editor-mode">markdown · 实时预览</span>
						<button
							type="button"
							id="toggle-preview"
							class="admin-btn"
							aria-controls="preview-pane"
							aria-expanded="false"
						>
							切换预览
						</button>
					</div>
					<textarea
						id="body-input"
						class="admin-textarea"
						name="body_md"
						rows="24"
						aria-describedby="body-help"
						placeholder="在这里写 Markdown 正文…">{v.body_md}</textarea>
					<p id="body-help" class="admin-help" style="margin-top: 0.5rem;">
						支持标准 Markdown 语法；预览使用与站点一致的渲染管线。
					</p>

					<div id="preview-pane" class="hidden">
						<div class="prose dark:prose-invert max-w-none custom-md" id="preview-body"></div>
					</div>
				</div>
			</section>
		</div>

		<!-- 右栏：元信息 -->
		<div class="admin-editor-sidebar">
			<section class="admin-section-card admin-sticky-card">
				<div class="admin-section-card-header">
					<h2 class="admin-section-card-title">发布</h2>
					<span class="admin-editor-mode">{isEdit ? "编辑已有文章" : "新建文章"}</span>
				</div>
				<div class="admin-section-card-body">
					<div class="admin-status-track">
						<span class="admin-status-dot" id="status-dot" data-published={v.draft ? "false" : "true"}></span>
						<span>当前状态：<strong id="status-label">{v.draft ? "草稿" : "已发布"}</strong></span>
					</div>

					<label class="admin-field mb-4">
						<span class="admin-label">slug（URL 路径，唯一）</span>
						<input class="admin-input" name="slug" value={v.slug} required />
					</label>

					<label class="admin-field mb-4">
						<span class="admin-label">发布日期</span>
						<input class="admin-input" type="date" name="published_at" value={v.published_at} />
					</label>

					<div class="admin-checkbox-list mb-4">
						<label class="admin-checkbox">
							<input type="checkbox" name="draft" id="draft-toggle" checked={v.draft} />
							<span>草稿（不在站点显示）</span>
						</label>
						<label class="admin-checkbox">
							<input type="checkbox" name="pinned" checked={v.pinned} />
							<span>置顶</span>
						</label>
						<label class="admin-checkbox">
							<input type="checkbox" name="comment" checked={v.comment} />
							<span>允许评论</span>
						</label>
					</div>

					<div class="flex flex-col gap-2">
						<button type="submit" class="admin-btn admin-btn-primary" id="save-btn">
							{isEdit ? "保存修改" : "创建文章"}
						</button>
						{isEdit && (
							<a
								href={`/posts/${v.slug}/`}
								target="_blank"
								rel="noopener"
								class="admin-btn"
							>
								查看文章
							</a>
						)}
					</div>
				</div>
			</section>

			<section class="admin-section-card">
				<div class="admin-section-card-header">
					<h2 class="admin-section-card-title">分类与标签</h2>
				</div>
				<div class="admin-section-card-body">
					<label class="admin-field mb-4">
						<span class="admin-label">分类</span>
						<input class="admin-input" name="category" value={v.category} />
					</label>

					<label class="admin-field mb-4">
						<span class="admin-label">标签（逗号分隔）</span>
						<input class="admin-input" name="tags" value={v.tags} />
					</label>

					<label class="admin-field">
						<span class="admin-label">系列</span>
						<input class="admin-input" name="series" value={v.series} />
					</label>
				</div>
			</section>

			<section class="admin-section-card">
				<div class="admin-section-card-header">
					<h2 class="admin-section-card-title">封面与语言</h2>
				</div>
				<div class="admin-section-card-body">
					<label class="admin-field mb-4">
						<span class="admin-label">封面图路径</span>
						<input class="admin-input" name="image" value={v.image} placeholder="./images/cover.avif" />
					</label>

					<label class="admin-field">
						<span class="admin-label">语言</span>
						<input class="admin-input" name="lang" value={v.lang} placeholder="zh-CN" />
					</label>
				</div>
			</section>

			<details class="admin-section-card admin-details">
				<summary class="admin-details-summary">高级选项</summary>
				<div class="admin-section-card-body flex flex-col gap-4">
					<label class="admin-field">
						<span class="admin-label">作者</span>
						<input class="admin-input" name="author" value={v.author} />
					</label>
					<label class="admin-field">
						<span class="admin-label">原文链接</span>
						<input class="admin-input" name="source_link" value={v.source_link} />
					</label>
					<label class="admin-field">
						<span class="admin-label">许可名称</span>
						<input class="admin-input" name="license_name" value={v.license_name} />
					</label>
					<label class="admin-field">
						<span class="admin-label">许可链接</span>
						<input class="admin-input" name="license_url" value={v.license_url} />
					</label>
					<label class="admin-field">
						<span class="admin-label">系列序号</span>
						<input class="admin-input" type="number" name="series_order" value={v.series_order} />
					</label>
					<label class="admin-field">
						<span class="admin-label">访问密码（留空则公开）</span>
						<input
							class="admin-input"
							type="password"
							name="password"
							value={v.password}
							autocomplete="new-password"
						/>
					</label>
					<label class="admin-field">
						<span class="admin-label">密码提示</span>
						<input class="admin-input" name="password_hint" value={v.password_hint} />
					</label>
				</div>
			</details>
		</div>
	</div>
</form>

<script>
	const form = document.getElementById("post-form") as HTMLFormElement | null;
	const alertBox = document.getElementById("editor-alert");
	const okBox = document.getElementById("editor-ok");
	const saveBtn = document.getElementById("save-btn") as HTMLButtonElement | null;
	const bodyInput = document.getElementById("body-input") as HTMLTextAreaElement | null;
	const previewPane = document.getElementById("preview-pane");
	const previewBody = document.getElementById("preview-body");
	const toggleBtn = document.getElementById("toggle-preview");
	const draftToggle = document.getElementById("draft-toggle") as HTMLInputElement | null;
	const statusDot = document.getElementById("status-dot");
	const statusLabel = document.getElementById("status-label");

	function show(el: HTMLElement | null, msg: string) {
		if (!el) return;
		el.textContent = msg;
		el.classList.remove("hidden");
	}
	function hide(el: HTMLElement | null) {
		el?.classList.add("hidden");
	}

	// 预览：调用后台接口渲染，保证与站点最终效果一致
	let previewTimer: number | undefined;
	async function renderPreview() {
		if (!bodyInput || !previewBody) return;
		try {
			const res = await fetch(`${import.meta.env.BASE_URL}api/admin/preview`, {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ body_md: bodyInput.value }),
			});
			const data = (await res.json()) as { ok?: boolean; html?: string };
			if (data.ok && data.html !== undefined) {
				previewBody.innerHTML = data.html;
			}
		} catch {
			previewBody.textContent = "预览渲染失败";
		}
	}

	toggleBtn?.addEventListener("click", () => {
		if (!bodyInput || !previewPane) return;
		const showing = !previewPane.classList.contains("hidden");
		if (showing) {
			previewPane.classList.add("hidden");
			bodyInput.classList.remove("hidden");
			toggleBtn.textContent = "切换预览";
			toggleBtn.setAttribute("aria-expanded", "false");
		} else {
			previewPane.classList.remove("hidden");
			bodyInput.classList.add("hidden");
			toggleBtn.textContent = "返回编辑";
			toggleBtn.setAttribute("aria-expanded", "true");
			void renderPreview();
		}
	});

	// 状态条跟随「草稿」勾选，保存前就能看出将发布成什么状态
	draftToggle?.addEventListener("change", () => {
		const draft = draftToggle.checked;
		statusDot?.setAttribute("data-published", draft ? "false" : "true");
		if (statusLabel) statusLabel.textContent = draft ? "草稿" : "已发布";
	});

	bodyInput?.addEventListener("input", () => {
		if (previewPane?.classList.contains("hidden")) return;
		clearTimeout(previewTimer);
		previewTimer = window.setTimeout(() => void renderPreview(), 400);
	});

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();
		hide(alertBox);
		hide(okBox);
		if (saveBtn) saveBtn.disabled = true;

		const fd = new FormData(form);
		const isEdit = form.dataset.edit === "1";
		const originalSlug = form.dataset.slug ?? "";

		const payload = {
			slug: String(fd.get("slug") ?? "").trim(),
			title: String(fd.get("title") ?? "").trim(),
			description: String(fd.get("description") ?? ""),
			body_md: String(fd.get("body_md") ?? ""),
			image: String(fd.get("image") ?? ""),
			category: String(fd.get("category") ?? ""),
			lang: String(fd.get("lang") ?? ""),
			pinned: fd.get("pinned") === "on",
			draft: fd.get("draft") === "on",
			comment: fd.get("comment") === "on",
			author: String(fd.get("author") ?? ""),
			source_link: String(fd.get("source_link") ?? ""),
			license_name: String(fd.get("license_name") ?? ""),
			license_url: String(fd.get("license_url") ?? ""),
			password: String(fd.get("password") ?? ""),
			password_hint: String(fd.get("password_hint") ?? ""),
			series: String(fd.get("series") ?? ""),
			series_order: String(fd.get("series_order") ?? ""),
			published_at: String(fd.get("published_at") ?? ""),
			tags: String(fd.get("tags") ?? ""),
		};

		const endpoint = isEdit
			? `${import.meta.env.BASE_URL}api/admin/posts/${encodeURIComponent(originalSlug)}`
			: `${import.meta.env.BASE_URL}api/admin/posts`;

		try {
			const res = await fetch(endpoint, {
				method: isEdit ? "PUT" : "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(payload),
			});
			const data = (await res.json()) as { ok?: boolean; error?: string; slug?: string };

			if (res.ok && data.ok) {
				if (isEdit) {
					show(okBox, "已保存");
				} else {
					location.href = `${import.meta.env.BASE_URL}admin/posts/${encodeURIComponent(data.slug ?? payload.slug)}/`;
				}
				return;
			}
			show(alertBox, data.error ?? "保存失败");
		} catch (err) {
			show(alertBox, err instanceof Error ? err.message : "网络错误");
		} finally {
			if (saveBtn) saveBtn.disabled = false;
		}
	});
</script>
