{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Worker 名称需与 Cloudflare 上 Workers Builds 里配置的一致，
	// 否则部署时 CI 会强制覆盖成本项并尝试提 PR 修正。改名前先确认控制台里的名字。
	"name": "firefly-cf",
	"compatibility_date": "2025-10-01",
	"compatibility_flags": ["nodejs_compat"],
	// 后台与公开站同一 Worker：/admin 与 D1 驱动的内容走 Worker，
	// 其余静态资源由 Cloudflare 直接托管。
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "404-page"
	},
	// 只写 binding 名、不填 database_id：wrangler 4.45+ 会在首次部署时
	// 自动创建数据库并回填 ID，实现 fork 后零配置即可部署。
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "firefly-cms",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}
